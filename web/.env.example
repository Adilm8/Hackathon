# Copy this file to .env.local and fill in the values. Never commit .env.local.

# LLM providers
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Which provider the server calls first: openrouter or gemini
LLM_PROVIDER=openrouter

# Stripe, test mode only (starts with sk_test_)
STRIPE_SECRET_KEY=

# Random string used to sign paid-access tokens (for example: openssl rand -hex 32)
ENTITLEMENT_SECRET=

# Public URL of the app (http://localhost:3000 locally, the Railway domain in production)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Later: voice generation and recognition
ELEVENLABS_API_KEY=
