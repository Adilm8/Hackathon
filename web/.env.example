# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Full description of every variable: docs/SPEC.md, section 12.6.

# --- LLM ---
# gemini = used for now, within its limits; openrouter = paid models, after the evaluation;
# mock = no key and no cost (text from templates). A missing key or model falls back to mock.
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# OpenRouter model id for chapters and ritual cards (chosen by the evaluation, docs/SPEC.md 8.8)
OPENROUTER_MODEL=
# Optional: faster model for answers. Empty = OPENROUTER_MODEL
OPENROUTER_MODEL_ANSWER=
# Optional: model used for two minutes after the main one fails twice
OPENROUTER_MODEL_BACKUP=
# Model used when LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
# Hard daily spending cap in USD, enforced by the server
LLM_BUDGET_USD_PER_DAY=1

# --- Database ---
# PostgreSQL connection string (Railway provides it). Empty = embedded database in web/.data for development
DATABASE_URL=

# --- Stripe, test mode only (starts with sk_test_) ---
STRIPE_SECRET_KEY=
# Optional, after the deploy: signing secret of the webhook endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional: on = fake payments in a production build without a Stripe key (demo servers only)
STRIPE_MOCK=

# --- App ---
# Long random string that signs the family session cookie (for example: openssl rand -hex 32)
ENTITLEMENT_SECRET=
# Optional: random string that protects /api/admin/usage
ADMIN_KEY=
# Jury demo mode for the sample (guided tour, demo access): on or off
DEMO_MODE=on
# Public URL of the app (http://localhost:3000 locally). Empty = taken from the request
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Later: voice generation and recognition (docs/SPEC.md 17.1) ---
ELEVENLABS_API_KEY=
