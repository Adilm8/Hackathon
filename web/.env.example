# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Full description of every variable: docs/SPEC.md, section 12.6.

# --- LLM ---
# gemini = used for now, within its limits; openrouter = paid models, after the evaluation;
# mock = no key and no cost (text from templates). A missing key or model falls back to mock.
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# OpenRouter model id for chapters and ritual cards (chosen by the evaluation, docs/SPEC.md 8.8)
OPENROUTER_MODEL=
# Optional: faster model for answers. Empty = OPENROUTER_MODEL
OPENROUTER_MODEL_ANSWER=
# Optional: model used for two minutes after the main one fails twice
OPENROUTER_MODEL_BACKUP=
# Model used when LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
# Hard daily spending cap in USD, enforced by the server
LLM_BUDGET_USD_PER_DAY=1
# Optional: generate the sample's chapters in the background every hour (spends on a paid provider)
LLM_WARM_SAMPLE=off

# --- Database ---
# PostgreSQL connection string (Railway provides it). Empty = embedded database in web/.data for development
DATABASE_URL=

# --- Stripe, test mode only (starts with sk_test_) ---
STRIPE_SECRET_KEY=
# Optional, after the deploy: signing secret of the webhook endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional: on = fake payments in a production build without a Stripe key (demo servers only)
STRIPE_MOCK=

# --- App ---
# Long random string that signs the family session cookie (for example: openssl rand -hex 32)
ENTITLEMENT_SECRET=
# Optional: random string that protects /api/admin/usage
ADMIN_KEY=
# Jury demo mode for the sample (guided tour, demo access): on or off
DEMO_MODE=on
# Public URL of the app (http://localhost:3000 locally). Empty = taken from the request
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Web push reminders (optional) ---
# Generate once with `npm run vapid`. Empty = no push, the app shows reminders inside the app only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto: or https: URL). Empty = NEXT_PUBLIC_BASE_URL
VAPID_SUBJECT=

# --- Premium story voice (docs/voice-options.md). Off while TTS_MODEL is empty. Spends on OpenRouter. ---
# OpenRouter speech model id. Voice test of 15 Nov picked Kokoro (fast, ~$0.002 a chapter):
# TTS_MODEL=hexgrad/kokoro-82m
TTS_MODEL=
# Optional: character voices the parent can pick, "voice=Label" or "model@voice=Label" (first = default).
# Our own invented characters only. Voice test picks (15 Nov): Kokoro Bella, Fish Free, ElevenLabs v3 Lily.
# TTS_VOICES=af_bella=Owl the Storyteller,fish-audio/s2.1-pro-free:free@=Kind Friend,bf_emma=Grandma Bear,am_michael=Night Whale,elevenlabs/eleven-v3@pFZP5JQG7iQjIQuC4Bku=Moon Storyteller
TTS_VOICES=
# Price in USD per million characters for models the code does not know, counted against LLM_BUDGET_USD_PER_DAY
TTS_PRICE_PER_M_CHARS=80
# Optional: on = only providers with zero data retention (fewer models qualify)
TTS_ZDR=
# Optional: folder for cached audio (a Railway Volume in production). Empty = web/.data/tts
TTS_CACHE_DIR=
# --- Later: voice cloning directly with ElevenLabs (docs/SPEC.md 17.1) ---
ELEVENLABS_API_KEY=
